# I SEE gateway configuration. Copy to .env and fill in. .env is git-ignored.
# Keys stay on the server: they are never sent to the browser, never logged,
# and must never be given to Muse Code or any other development tool.

# --- Meta Model API (Muse Spark, Muse Wonder, Muse Image, Muse Voice Transcribe, SAM 3.1) ---
# Create a key at https://dev.meta.ai. Format: LLM|<id>|<secret>
MODEL_API_KEY=
# META_MODEL_API_KEY is accepted as an alias.
# META_API_BASE=https://api.meta.ai/v1

# Privacy tier for Muse Spark:
#   private      muse-spark-1.3              (default; Meta states these requests are not used to improve its products)
#   contributor  muse-spark-1.3-contributor  (cheaper; requests ARE used to improve Meta's products)
PRIVACY_TIER=private

# Model ids (override only if Meta publishes new versions)
# MODEL_SPARK=muse-spark-1.3
# MODEL_SPARK_CONTRIBUTOR=muse-spark-1.3-contributor
# MODEL_WONDER=muse-wonder-1.0
# MODEL_IMAGE=muse-image-1.0
# MODEL_ASR=muse-voice-transcribe-1.0
# MODEL_SAM=sam-3.1

# Muse Spark web search grounding (only search queries are sent, never photos)
SEARCH_GROUNDING=true

# --- Muse Spark Open (open weights) on any OpenAI-compatible host ---
# Powers the "private" route and the second opinion on the "consensus" route.
# Examples (check your provider's exact model slug before use):
#   Baseten (hackathon key: use exactly this model name):
#               OPEN_WEIGHT_BASE_URL=https://inference.baseten.co/v1   OPEN_WEIGHT_MODEL=meta-models/muse-spark-open-1026
#   Fireworks:  OPEN_WEIGHT_BASE_URL=https://api.fireworks.ai/inference/v1  OPEN_WEIGHT_MODEL=accounts/fireworks/models/muse-spark-open
#   OpenRouter: OPEN_WEIGHT_BASE_URL=https://openrouter.ai/api/v1      OPEN_WEIGHT_MODEL=meta/muse-spark-open
#   vLLM:       OPEN_WEIGHT_BASE_URL=http://localhost:8000/v1          OPEN_WEIGHT_MODEL=meta-models/Muse-Spark-Open-816B-A42B
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=
# Set true only if the host enforces response_format json_schema; otherwise JSON is prompted and validated.
OPEN_WEIGHT_JSON_SCHEMA=false
OPEN_WEIGHT_VISION=true
# Send reasoning_effort (low / medium / high per task). Muse Spark Open on Baseten supports it; without it the
# model reasons at its slowest default level. Set false for hosts that reject the parameter.
OPEN_WEIGHT_REASONING_EFFORT=true

# --- Muse Glimmer (30B, Apache 2.0), usually on your own machine ---
# Powers the "local-first" route: nothing leaves the machine unless the person approves.
#   Ollama: LOCAL_BASE_URL=http://localhost:11434/v1  LOCAL_MODEL=muse-glimmer
LOCAL_BASE_URL=
LOCAL_MODEL=muse-glimmer
LOCAL_API_KEY=
LOCAL_JSON_SCHEMA=false
LOCAL_VISION=true

# --- Server ---
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_PER_MINUTE=30
MAX_IMAGE_BYTES=8388608
REQUEST_TIMEOUT_MS=120000
# How parts are found on a photo: segments (regions traced from the pixels, then named; default)
# or boxes (each part's box outlined, then checked).
LABEL_METHOD=segments
# Retrieval connectors (comma list). Default: all of
# wikipedia,wikidata,met,aic,cpsc,nhtsa,gbif,openfoodfacts,ifixit
# CONNECTORS=
# Sent in the User-Agent to public APIs (Wikipedia asks for a contact)
CONTACT_EMAIL=
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=0
# Serve the built web app from this folder (npm start sets dist automatically)
# STATIC_DIR=dist
# Probe results written by `npm run models:probe -- --save probe.json`
# PROBE_RESULTS=probe.json
LOG_LEVEL=info

