{
  "name": "i-see",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "I SEE: point a camera at an object and learn what it is, how it works, and how we know. Built on Meta's Muse models.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,cyan \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "build:preview": "vite build --mode preview && node scripts/inline-preview.mjs",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:connection": "tsx --env-file-if-exists=.env scripts/check-connection.ts",
    "models:probe": "tsx --env-file-if-exists=.env scripts/probe-models.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "specimens": "node scripts/specimens/render.cjs",
    "e2e": "node scripts/e2e.cjs",
    "e2e:live": "npm run build && tsx scripts/e2e-live.ts",
    "sample:capture": "tsx --env-file-if-exists=.env scripts/capture-sample.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@meta-sam/parser": "^0.1.0",
    "d3-force": "^3.0.0",
    "hono": "^4.13.14",
    "idb": "^8.0.4",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
